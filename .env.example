# 复制本文件为 .env 并修改（docker compose 会自动读取同目录下的 .env）
# 例： cp .env.example .env

# 后台管理员密码（至少 6 位，请使用强密码；不填则默认 admin123）
ADMIN_PASSWORD=请改成强密码至少6位

# 服务端口（容器内固定 51888，这里指宿主机映射端口）
PORT=51888

# 站点名称
SITE_NAME=医保专栏

# 私有镜像仓库前缀（推送/拉取镜像用；含末尾斜杠，如 registry.example.com/medical/；留空则仅本地）
REGISTRY=
# 镜像标签（建议用版本号，如 1.0.0；默认 latest）
TAG=latest
